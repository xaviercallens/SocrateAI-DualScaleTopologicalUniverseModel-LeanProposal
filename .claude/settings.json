      "Bash(wc*)",
      "Bash(pwd)",
      "Bash(echo*)",
      "Bash(date*)",
      "Bash(which*)",
      "Bash(file*)",
      "Bash(stat*)",
      "Bash(sha256sum*)",
      "Bash(md5sum*)",
