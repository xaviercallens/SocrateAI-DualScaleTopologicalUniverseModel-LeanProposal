      "Bash(pytest*)",
      "Bash(pip list*)",
      "Bash(pip show*)",
      "Bash(pip freeze*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push*--force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -*)",
      "Bash(git clean -f*)",
      "Bash(git clean*-f*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git branch -D*)",
      "Bash(git tag -d*)",
      "Bash(git push --delete*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm*-rf*)",
      "Bash(rm*-fr*)",
      "Bash(rm*)",
      "Bash(rmdir*)",
      "Bash(mv*)",
      "Bash(sudo*)",
      "Bash(chmod*)",
      "Bash(chown*)",
      "Bash(truncate*)",
      "Bash(kill*)",
      "Bash(pkill*)",
      "Bash(killall*)",
      "Bash(pip install*)",
      "Bash(pip uninstall*)",
      "Bash(npm install*)",
      "Bash(apt*)",
      "Bash(systemctl*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf .)",
      "Bash(sudo rm -rf*)",
      "Bash(mkfs*)",
      "Bash(dd of=/dev/*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",
      "Bash(poweroff*)",
      "Bash(chmod -R 777 /*)",
      "Bash(> /dev/sd*)",
      "Bash(git push --force origin main*)",
      "Bash(git push --force origin master*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/lean_guard.sh",
            "timeout": 10,
            "statusMessage": "Checking Lean axiom/sorry placement..."
          }
        ]
      }
    ]
  }
}
