# Lean 4 (build artifacts only; manifest and toolchain are pinned)
# Match both a real directory and a symlink — worktrees point .lake at the data
# disk, and a bare `.lake/` pattern does NOT match a symlink, so without the
# second line `git add -A` would commit the link.
.lake/
.lake
.build/
.lean/

# Python
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# LaTeX build artifacts (paper/main.pdf is committed; these regenerate on compile)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

